# Eduventure — variables for docker-compose.prod.yml
# Copy to `.env` (repo root) and replace every secret:  cp .env.prod.example .env
# Generate secrets with:  openssl rand -hex 32

# PostgreSQL (internal to the compose network; use URL-safe characters in the password)
POSTGRES_DB=eduventure
POSTGRES_USER=eduventure
POSTGRES_PASSWORD=change-me-db-password

# JWT signing secrets (access 15m, refresh 30d) — long random strings, different from each other
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Public URL of the web app (CORS origin for the API)
WEB_ORIGIN=http://localhost:3000

# Optional: Google Gemini key for AI question generation (deterministic mock when empty)
GEMINI_API_KEY=

# Load demo accounts/content on API start (set true for the first run, then back to false)
SEED_ON_START=false

# Host ports
WEB_PORT=3000
API_PORT=4000
