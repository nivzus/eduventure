# PostgreSQL connection (docker compose up -d db  → see repo-root docker-compose.yml)
DATABASE_URL="postgresql://eduventure:eduventure@localhost:5432/eduventure?schema=public"

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Optional: Google Gemini key for /api/ai/generate-questions (deterministic mock when empty)
GEMINI_API_KEY=""

# Frontend origin allowed by CORS (credentials enabled)
WEB_ORIGIN="http://localhost:3000"

# Where uploaded files are stored; served under /api/uploads
UPLOAD_DIR="./uploads"

PORT=4000

# ── Production only ──────────────────────────────────────────────
# NODE_ENV=production makes the API refuse weak/missing secrets (see src/common/env.ts).
# NODE_ENV="production"
# Accounts created by `npm run seed:prod` (safe, never deletes data):
# ADMIN_EMAIL="admin@your-domain.az"
# ADMIN_PASSWORD="at-least-10-characters"
# TEACHER_EMAIL="sedaqet@your-domain.az"
# TEACHER_PASSWORD="at-least-10-characters"
# TEACHER_NAME="Sədaqət Ağayeva"
